rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: own read/write. Also allow updating colaborator-related fields by other auth'd users
    // (needed when owner assigns existing user as colaborador).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['collaboratingPropertyIds', 'roles', 'updatedAt']);
    }

    // Properties: public read if isPublic, owner or colaborator read/write.
    // Tenant can read property where they are tenantUid.
    // Tenant can update tenantUid + updatedAt on first login (email match).
    match /properties/{propertyId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.ownerId)
                  || (request.auth != null && request.auth.uid in resource.data.get('collaboratorUids', []))
                  || (request.auth != null && request.auth.uid == resource.data.tenantUid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || request.auth.uid in resource.data.get('collaboratorUids', [])
      );
      // Allow tenant to link their uid on first login (only tenantUid + updatedAt fields)
      allow update: if request.auth != null
                    && request.auth.token.email == resource.data.tenantEmail
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantUid', 'updatedAt']);
    }

    // Payments: owner or colaborador can read/write; tenant can read payments for their property.
    match /payments/{paymentId} {
      // El propertyId debe existir y apuntar a un documento real: un get() sobre un
      // path con ID vacio, o sobre una propiedad borrada, hace fallar la evaluacion
      // y eso DENIEGA. En un listado basta un documento asi para tumbar la consulta.
      function paymentPropertyOk() {
        return resource.data.get('propertyId', '') is string
               && resource.data.get('propertyId', '') != ''
               && exists(/databases/$(database)/documents/properties/$(resource.data.propertyId));
      }
      function paymentProperty() {
        return get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data;
      }

      // La primera condicion cortocircuita y evita cualquier get() en el caso normal.
      // `getByProperty` consulta por propertyId SIN filtrar ownerId, asi que trae pagos
      // de cualquier origen (colaborador, webhook de Stripe, datos antiguos). Sin la
      // clausula de dueno de la propiedad, un solo pago con otro ownerId denegaba todo.
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.get('ownerId', '')
        || (paymentPropertyOk() && (
             request.auth.uid == paymentProperty().ownerId
             || request.auth.uid in paymentProperty().get('collaboratorUids', [])
             || request.auth.uid == paymentProperty().get('tenantUid', '')
           ))
      );
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.get('ownerId', '')
        || (paymentPropertyOk() && (
             request.auth.uid == paymentProperty().ownerId
             || request.auth.uid in paymentProperty().get('collaboratorUids', [])
           ))
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.ownerId
        || request.auth.uid in get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
                               .data.get('collaboratorUids', [])
      );
    }

    // Expenses: owner or colaborador de la propiedad puede leer/escribir.
    // Los gastos se atribuyen siempre al dueño de la propiedad, incluso cuando
    // los crea un colaborador (o el pago automático de un recibo de servicio).
    match /expenses/{expenseId} {
      function expensePropertyOk() {
        return resource.data.get('propertyId', '') is string
               && resource.data.get('propertyId', '') != ''
               && exists(/databases/$(database)/documents/properties/$(resource.data.propertyId));
      }
      function expenseProperty() {
        return get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data;
      }

      // Igual que en payments y serviceReceipts: sin la clausula de dueno de la
      // propiedad, un gasto creado por un colaborador (o el gasto automatico de un
      // recibo suyo) quedaba ilegible e imborrable para el dueno.
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.get('ownerId', '')
        || (expensePropertyOk() && (
             request.auth.uid == expenseProperty().ownerId
             || request.auth.uid in expenseProperty().get('collaboratorUids', [])
           ))
      );
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.ownerId
        || request.auth.uid in get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
                               .data.get('collaboratorUids', [])
      );
    }

    // Tickets: owner or colaborador can read/update; tenant can read/create their own.
    match /tickets/{ticketId} {
      function isCollaboratorOnTicket() {
        return request.auth != null
               && request.auth.uid in get(/databases/$(database)/documents/properties/$(resource.data.propertyId))
                                      .data.get('collaboratorUids', []);
      }

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || request.auth.uid == resource.data.tenantUid
        || isCollaboratorOnTicket()
      );
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.tenantUid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || isCollaboratorOnTicket()
      );
      allow delete: if false;
    }

    // Notifications: owner reads their own; written only by Cloud Functions (Admin SDK).
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // PaymentLinks: owner reads/creates; tenant reads links for their property.
    match /paymentLinks/{linkId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || request.auth.uid == get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.tenantUid
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if false; // Cloud Functions (Admin SDK) only
      allow delete: if false;
    }

    // MonthlySnapshots: owner reads their own; written only by Cloud Functions.
    match /monthlySnapshots/{snapshotId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // Services: owner or collaborator can read/write.
    match /services/{serviceId} {
      // Los documentos de `services` no tienen campo `propertyId`. La regla anterior
      // hacia get(.../properties/$(resource.data.get('propertyId', ''))): un get() sobre
      // un path con ID vacio, es decir path invalido, evaluacion fallida y denegacion.
      // Solo se disparaba cuando ownerId != uid (el || cortocircuita para el dueno),
      // que es justo lo que consulta UtilityServiceService.getAll().
      // Los servicios se comparten dentro del circulo dueño+colaboradores:
      // getAll() consulta ownerId in [uid propio + dueños de propiedades colaboradas
      // + colaboradores en propiedades propias]. Un Service no tiene propertyId, asi
      // que ese circulo NO se puede expresar aqui: no hay documento intermedio que
      // consultar con get(), como si lo hay en payments, expenses y serviceReceipts.
      //
      // Con la regla anterior (uid == resource.data.ownerId) un servicio creado por
      // un colaborador quedaba ineditable e inborrable para el dueño de las
      // propiedades, aunque la lista si se lo mostrara.
      //
      // Se alinea la escritura con la lectura, que ya era abierta a cualquier
      // autenticado. Un Service solo guarda nombre, icono, descripcion y estado:
      // no hay montos ni datos personales. El control efectivo de quien puede
      // tocarlos es el permiso `servicios` del colaborador, aplicado en la UI.
      // Los importes viven en serviceReceipts, cuya escritura si esta restringida
      // al dueño de la propiedad o a sus colaboradores.
      //
      // Alternativa mas estricta, si se quisiera: denormalizar en cada service un
      // array con los uids del circulo y validar contra el, manteniendolo en sync
      // al agregar o quitar colaboradores.
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Service Assignments: owner or collaborator on any of the assignment's properties can read/write.
    match /serviceAssignments/{assignmentId} {
      function isCollaboratorOnAssignment() {
        return resource.data.propertyIds.size() > 0
          && request.auth.uid in get(/databases/$(database)/documents/properties/$(resource.data.propertyIds[0])).data.get('collaboratorUids', []);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId
        || isCollaboratorOnAssignment()
      );
    }

    // Service Receipts: owner or collaborator on the receipt's property can read/write.
    match /serviceReceipts/{receiptId} {
      function receiptPropertyOk() {
        return resource.data.get('propertyId', '') is string
               && resource.data.get('propertyId', '') != ''
               && exists(/databases/$(database)/documents/properties/$(resource.data.propertyId));
      }
      function receiptProperty() {
        return get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data;
      }
      // Dueno de la propiedad o colaborador. Los recibos generados por un colaborador
      // llevan su uid en ownerId, asi que sin la clausula de dueno de la propiedad el
      // dueno no podia editarlos ni borrarlos.
      function canWriteReceipt() {
        return request.auth.uid == resource.data.get('ownerId', '')
               || (receiptPropertyOk() && (
                    request.auth.uid == receiptProperty().ownerId
                    || request.auth.uid in receiptProperty().get('collaboratorUids', [])
                  ));
      }

      // Lectura permisiva a proposito. Endurecerla con get() por documento arriesga
      // denegar listados completos: hay un tope de accesos a documentos por consulta,
      // y basta un documento que lo exceda para tumbar la consulta entera. El hueco
      // grave era la escritura (cualquier autenticado podia crear o alterar recibos
      // ajenos) y esa si queda cerrada abajo, donde el coste del get() es por documento.
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        request.auth.uid == get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId
        || request.auth.uid in get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
                               .data.get('collaboratorUids', [])
      );
      allow update, delete: if request.auth != null && canWriteReceipt();
    }

    // Mail: write-only from Cloud Functions (Admin SDK). No client access needed.
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
